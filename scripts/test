#!/bin/bash

# Colors
BLUE='\033[34m'
GREEN='\033[32m'
RED='\033[31m'
YELLOW='\033[33m'
NC='\033[0m' # No Color

cd "$(dirname "$0")/.."

if ! command -v uv > /dev/null 2>&1; then
  echo "uv not found - install it (https://docs.astral.sh/uv/) or rebuild the devcontainer." >&2
  exit 1
fi

# --inexact: the devcontainer's default_config packages (av, numpy, Pillow...) are
# installed on top of the lock by scripts/setup and must not be pruned - an exact
# sync would remove them and scripts/develop would stop booting.
# --frozen: running a check never rewrites uv.lock.
uv sync --frozen --inexact --quiet || exit 1
VIRTUAL_ENV="$PWD/.venv"
export VIRTUAL_ENV
PATH="$VIRTUAL_ENV/bin:$PATH"
export PATH

echo -e "\n${YELLOW}> Running tests with coverage :${NC}\n"

pytest
pytest_exit=$?

if [ $pytest_exit -eq 0 ]; then
  echo -e "\n${BLUE}[pytest]${NC} ${GREEN}✓ Done.${NC}\n"
else
  echo -e "\n${BLUE}[pytest]${NC} ${RED}✗ Failed.${NC}\n"
fi

exit $pytest_exit

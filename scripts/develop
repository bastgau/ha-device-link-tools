#!/bin/bash

set -e

cd "$(dirname "$0")/.."

if ! command -v uv > /dev/null 2>&1; then
  echo "uv not found - install it (https://docs.astral.sh/uv/) or rebuild the devcontainer." >&2
  exit 1
fi

# --inexact: the default-config group (av, numpy, Pillow...) is not a default
# group, so an exact sync would prune whatever scripts/setup installed from it and
# scripts/develop would stop booting. Syncing it here instead would make every
# lint and test run pay for packages neither of them imports.
# --frozen: running a check never rewrites uv.lock.
uv sync --frozen --inexact --quiet || exit 1
VIRTUAL_ENV="$PWD/.venv"
export VIRTUAL_ENV
PATH="$VIRTUAL_ENV/bin:$PATH"
export PATH

# Create config dir if not present. Booting needs the default_config packages
# scripts/setup installs on top of the lock; run it again if hass fails to start.
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

export PYTHONPATH="${PYTHONPATH}:${PWD}/custom_components"

# Start Home Assistant
hass --config "${PWD}/config" --debug

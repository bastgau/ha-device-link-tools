#!/usr/bin/env python3
"""Regenerate the default-config dependency group and keep uv in step.

`configuration.yaml` uses `default_config:`, which loads ~55 Home Assistant
integrations (frontend, ffmpeg, usb, dhcp, bluetooth, matter, tts, camera...).
None of their Python dependencies are installed by `homeassistant` itself, so
they must be tracked here. This script walks the manifests of every integration
reachable from default_config (following dependencies and after_dependencies),
collects their `requirements`, and rewrites three things from them:

- the `default-config` group in pyproject.toml, a non-default group so a plain
  `uv sync` never installs these ~40 heavy packages;
- the `ignore` list of the uv ecosystem in .github/dependabot.yml, because Home
  Assistant pins these itself: a Dependabot bump would be reverted by the next
  run of this script;
- uv.lock, by running `uv lock` at the end.

Run it whenever homeassistant is upgraded, as
`uv run --frozen python scripts/update_requirements` - it imports the installed
homeassistant, so it needs the interpreter of the project's virtualenv. Review
the diff, then run scripts/setup to install the result.
"""

from __future__ import annotations

import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Any

import homeassistant

Manifest = dict[str, Any]

PYPROJECT_BEGIN = "# BEGIN default-config - auto-generated by scripts/update_requirements"
PYPROJECT_END = "# END default-config"
DEPENDABOT_BEGIN = "# BEGIN default-config ignores - auto-generated by scripts/update_requirements"
DEPENDABOT_END = "# END default-config ignores"

REPO_ROOT = Path(__file__).resolve().parent.parent
PYPROJECT_FILE = REPO_ROOT / "pyproject.toml"
DEPENDABOT_FILE = REPO_ROOT / ".github" / "dependabot.yml"

# Components that default_config loads dynamically at runtime (e.g. via
# bluetooth adapter discovery) rather than declaring as a static manifest
# dependency. Their manifests aren't reachable by walking dependencies, so
# they're listed here explicitly.
EXTRA_COMPONENTS = {
    "esphome",  # pulled in by bluetooth for ESPHome bluetooth proxies
}


def find_components_dir() -> Path:
    """Locate the installed homeassistant.components package directory."""
    return Path(homeassistant.__file__).parent / "components"


def load_manifest(components_dir: Path, component: str) -> Manifest | None:
    """Load a component's manifest.json, or None if it has no manifest."""
    manifest_path = components_dir / component / "manifest.json"
    if not manifest_path.is_file():
        return None
    return json.loads(manifest_path.read_text())


def collect_components(components_dir: Path) -> set[str]:
    """Return every component reachable from default_config's dependency tree."""
    default_config_manifest = load_manifest(components_dir, "default_config")
    if default_config_manifest is None:
        msg = "Could not find homeassistant.components.default_config manifest"
        raise RuntimeError(msg)

    seen: set[str] = set()

    def expand(component: str) -> None:
        if component in seen:
            return
        seen.add(component)
        manifest = load_manifest(components_dir, component)
        if manifest is None:
            return
        for dep in manifest.get("dependencies", []) + manifest.get("after_dependencies", []):
            expand(dep)

    for dep in default_config_manifest.get("dependencies", []):
        expand(dep)
    for component in EXTRA_COMPONENTS:
        expand(component)

    return seen


def collect_requirements(components_dir: Path, components: set[str]) -> dict[str, str]:
    """Map each dependency's lowercased package name to its pinned requirement string."""
    requirements: dict[str, str] = {}
    for component in sorted(components):
        manifest = load_manifest(components_dir, component)
        if manifest is None:
            continue
        for req in manifest.get("requirements", []):
            pkg = re.split(r"[=<>!]", req, maxsplit=1)[0]
            requirements[pkg.lower()] = req
    return requirements


def replace_generated_block(path: Path, begin: str, end: str, body: list[str]) -> None:
    """Replace the lines between two marker comments, keeping their indentation.

    The markers are left in place, so the block can be regenerated any number of
    times; everything between them is discarded.

    Args:
        path (Path): The file to rewrite.
        begin (str): The opening marker comment, without indentation.
        end (str): The closing marker comment, without indentation.
        body (list[str]): The replacement lines, without indentation.

    Raises:
        RuntimeError: If either marker is missing, or they are out of order.

    """
    lines = path.read_text().split("\n")
    begin_index = next((i for i, line in enumerate(lines) if line.strip() == begin), None)
    end_index = next((i for i, line in enumerate(lines) if line.strip() == end), None)
    if begin_index is None or end_index is None or end_index <= begin_index:
        msg = f"Could not find the generated block between {begin!r} and {end!r} in {path}"
        raise RuntimeError(msg)

    # The markers carry the indentation the generated lines have to match: the
    # pyproject group sits at column 0, the dependabot list two levels in.
    indent = lines[begin_index][: len(lines[begin_index]) - len(lines[begin_index].lstrip())]
    generated = [f"{indent}{line}" if line else "" for line in body]
    path.write_text("\n".join(lines[: begin_index + 1] + generated + lines[end_index:]))


def rewrite_dependency_group(requirements: dict[str, str]) -> None:
    """Rewrite the default-config group in pyproject.toml.

    Args:
        requirements (dict[str, str]): Package name to pinned requirement string.

    """
    body = ["default-config = ["]
    body += [f'  "{requirements[pkg]}",' for pkg in sorted(requirements)]
    body += ["]"]
    replace_generated_block(PYPROJECT_FILE, PYPROJECT_BEGIN, PYPROJECT_END, body)


def rewrite_dependabot_ignores(requirements: dict[str, str]) -> None:
    """Rewrite the uv ecosystem's ignore list in .github/dependabot.yml.

    Args:
        requirements (dict[str, str]): Package name to pinned requirement string.

    """
    body = ["ignore:"]
    # The requirement string carries the name Home Assistant uses; Dependabot
    # matches case-insensitively, so it is quoted verbatim rather than lowercased.
    body += [f'  - dependency-name: "{re.split(r"[=<>!]", requirements[pkg], maxsplit=1)[0]}"' for pkg in sorted(requirements)]
    replace_generated_block(DEPENDABOT_FILE, DEPENDABOT_BEGIN, DEPENDABOT_END, body)


def relock() -> int:
    """Refresh uv.lock so the regenerated group is locked, returning uv's exit code.

    Returns:
        int: The exit code of `uv lock`.

    """
    print("Refreshing uv.lock")  # noqa: T201
    return subprocess.run(["uv", "lock"], cwd=REPO_ROOT, check=False).returncode  # noqa: S603, S607


def main() -> int:
    """Regenerate the default-config group, the Dependabot ignores and the lock.

    Returns:
        int: The process exit code.

    """
    print("Regenerating the default-config group from default_config: manifests")  # noqa: T201
    components_dir = find_components_dir()
    components = collect_components(components_dir)
    requirements = collect_requirements(components_dir, components)

    rewrite_dependency_group(requirements)
    rewrite_dependabot_ignores(requirements)
    print(f"Updated {PYPROJECT_FILE} and {DEPENDABOT_FILE} with {len(requirements)} requirements.")  # noqa: T201

    if (code := relock()) != 0:
        print("uv lock failed - review the group above before retrying.", file=sys.stderr)  # noqa: T201
        return code

    print("Review the diff, then run scripts/setup to install any new dependencies.")  # noqa: T201
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/bin/bash

# Runs the same five checks as .github/workflows/lint.yml, over the same three
# scopes, so that a green run here predicts a green run there - plus prettier,
# which the workflow does not run (the pre-commit hook is what enforces it).
#
# Usage: scripts/lint [scope ...]
#
#   integration   the Home Assistant side
#   tests         the whole test suite
#   repo          prettier over the repo's json/yaml/markdown
#   all           every scope (the default)


# Colors
BLUE='\033[34m'
GREEN='\033[32m'
PURPLE='\033[1;35m'
RED='\033[31m'
YELLOW='\033[33m'
NC='\033[0m' # No Color

cd "$(dirname "$0")/.." || exit 1

# Resolved from the script's own location rather than $PROJECT_NAME: the repo no longer has to sit at /workspaces/<project> for this to work.
scope_paths() {
  case "$1" in
    integration) echo custom_components/device_link_tools/*.py ;;
    tests)       echo tests/ ;;
    *)           return 1 ;;
  esac
}

# Expand the requested scopes, defaulting to all three.
requested=("$@")
[ ${#requested[@]} -eq 0 ] && requested=(all)

scopes=()
for arg in "${requested[@]}"; do
  case "$arg" in
    all) scopes+=(repo integration tests) ;;
    integration | tests | repo) scopes+=("$arg") ;;
    *)
      echo -e "${RED}Unknown scope '$arg'.${NC} Expected: integration, tests, repo or all." >&2
      exit 2
      ;;
  esac
done

exit_code=0

# Runs one tool over one scope, printing the project's usual banner and
# recording the failure without stopping: one invocation should report every
# problem at once, like the workflow does.
run_check() {
  local label="$1" scope_name="$2"
  shift 2

  echo -e "\n${YELLOW}> ${label} :${NC}\n"
  "$@"
  local status=$?

  if [ $status -eq 0 ]; then
    echo -e "\n${BLUE}[${label}]${NC} ${GREEN}✓ Done.${NC} ${PURPLE}(${scope_name})${NC}"
  else
    echo -e "\n${BLUE}[${label}]${NC} ${RED}✗ Failed.${NC} ${PURPLE}(${scope_name})${NC}"
    exit_code=1
  fi
}

# pylint's score is worth surfacing, so it gets its own wrapper rather than
# going through run_check.
run_pylint() {
  local scope_name="$1"
  shift

  echo -e "\n${YELLOW}> Lint with Pylint :${NC}"

  local output status score rating
  output=$(pylint "$@" 2>&1)
  status=$?
  echo "$output" | grep -v "^-\{10,\}$"
  rating=$(echo "$output" | grep "Your code has been rated")
  score=""
  if [ -n "$rating" ]; then
    score=$(echo "$rating" | grep -oP '\d+\.\d+/\d+' | head -1)
  fi

  if [ $status -eq 0 ]; then
    echo -e "\n${BLUE}[Lint with Pylint]${NC} Score: ${score} ${GREEN}✓ Done.${NC} ${PURPLE}(${scope_name})${NC}"
  else
    echo -e "\n${BLUE}[Lint with Pylint]${NC} Score: ${score} ${RED}✗ Failed.${NC} ${PURPLE}(${scope_name})${NC}"
    exit_code=1
  fi
}

# prettier is not a Python tool and is not installed in the venv: scripts/setup
# installs it globally, pinned to the version .pre-commit-config.yaml uses, so
# this script and the hook cannot drift apart. npx is the fallback for an
# environment where setup has not run.
#
# Deliberately WITHOUT prettier-plugin-sort-json, even though the hook lists it
# in additional_dependencies: nothing there passes --plugin and the repo has no
# .prettierrc, so the hook never actually loads it. Enabling it here would sort
# every JSON key alphabetically and scramble strings.json, whose block order
# Home Assistant relies on. Matching the hook's real behaviour beats matching
# its declaration.
PRETTIER_VERSION="3.6.2"
# Same exclusions as the hook: card/ is a vendored
# third-party file kept diffable against upstream.
PRETTIER_GLOBS=(
  "**/*.{json,yaml,yml,md}"
  "!card/**"
)

run_prettier() {
  local scope_name="$1"

  echo -e "\n${YELLOW}> Format with Prettier :${NC}\n"

  # The globally installed binary when scripts/setup has run, npx otherwise.
  local runner=(npx --yes "prettier@${PRETTIER_VERSION}")
  if [ "$(prettier --version 2> /dev/null)" = "$PRETTIER_VERSION" ]; then
    runner=(prettier)
  elif ! command -v npx > /dev/null 2>&1; then
    echo "Neither prettier nor npx found - run scripts/setup (the pre-commit hook is unaffected)."
    echo -e "\n${BLUE}[Format with Prettier]${NC} ${YELLOW}- Skipped.${NC} ${PURPLE}(${scope_name})${NC}"
    return
  fi

  local output status
  output=$("${runner[@]}" --write --log-level warn "${PRETTIER_GLOBS[@]}" 2>&1)
  status=$?
  # npx chatter is noise here; prettier's own findings are not.
  echo "$output" | grep -vE "^npm (notice|warn)" | grep -v "^$"

  if [ $status -eq 0 ]; then
    echo -e "\n${BLUE}[Format with Prettier]${NC} ${GREEN}✓ Done.${NC} ${PURPLE}(${scope_name})${NC}"
  else
    echo -e "\n${BLUE}[Format with Prettier]${NC} ${RED}✗ Failed.${NC} ${PURPLE}(${scope_name})${NC}"
    exit_code=1
  fi
}

for scope in "${scopes[@]}"; do
  # The repo scope runs one tool over the whole tree, not the five Python ones
  # over a path list, so it short-circuits the loop body below.
  if [ "$scope" = "repo" ]; then
    echo -e "\n${YELLOW}==================== scope: repo ====================${NC}"
    printf "%s\n" "json/yaml/markdown (excluding  card/)"
    run_prettier "repo"
    continue
  fi

  # Word splitting is wanted here: a scope resolves to one or more paths.
  # shellcheck disable=SC2046,SC2086
  paths=$(scope_paths "$scope")

  echo -e "\n${YELLOW}==================== scope: ${scope} ====================${NC}"
  # shellcheck disable=SC2086
  printf "%s\n" $paths

  # shellcheck disable=SC2086
  run_check "Lint with Ruff" "$scope" ruff check $paths
  # shellcheck disable=SC2086
  run_check "Format with Ruff" "$scope" ruff format --check $paths
  # shellcheck disable=SC2086
  run_pylint "$scope" $paths
  # shellcheck disable=SC2086
  run_check "Lint with Pyright" "$scope" pyright $paths
  # shellcheck disable=SC2086
  run_check "Lint with docstring-linter" "$scope" docstring-linter $paths
done

echo
if [ $exit_code -eq 0 ]; then
  echo -e "${GREEN}✓ All checks passed${NC} (${scopes[*]})"
else
  echo -e "${RED}✗ Some checks failed${NC} (${scopes[*]})"
fi

exit $exit_code
